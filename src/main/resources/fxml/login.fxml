<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.bookloop.controller.LoginController"
           styleClass="root-stack">

    <VBox alignment="CENTER" maxWidth="420" styleClass="auth-card">

        <!-- Logo + Branding -->
        <VBox alignment="CENTER" spacing="6">
            <VBox.margin><Insets top="36" bottom="4"/></VBox.margin>
            <Label text="📚" style="-fx-font-size: 52px;"/>
            <Label text="BookLoop" styleClass="app-title"/>
            <Label text="Peer-to-Peer Book Lending" styleClass="app-subtitle"/>
        </VBox>

        <!-- Form Fields -->
        <VBox spacing="14">
            <VBox.margin><Insets top="32" right="36" bottom="8" left="36"/></VBox.margin>

            <VBox spacing="6">
                <Label text="Email Address" styleClass="form-label"/>
                <TextField fx:id="emailField" promptText="you@example.com" styleClass="input-field"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Password" styleClass="form-label"/>
                <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="input-field"/>
            </VBox>

            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" maxWidth="Infinity"/>
        </VBox>

        <!-- Actions -->
        <VBox spacing="10" alignment="CENTER">
            <VBox.margin><Insets top="4" right="36" bottom="8" left="36"/></VBox.margin>
            <Button text="Sign In" onAction="#handleLogin"
                    styleClass="primary-button" maxWidth="Infinity" minHeight="42"/>
        </VBox>

        <HBox alignment="CENTER" spacing="4">
            <VBox.margin><Insets bottom="36"/></VBox.margin>
            <Label text="Don't have an account?" styleClass="auth-hint"/>
            <Hyperlink text="Sign Up" onAction="#handleRegister" styleClass="auth-link"/>
        </HBox>

    </VBox>
</StackPane>
