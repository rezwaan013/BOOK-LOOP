<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bookloop.controller.MyBooksController" spacing="12"
      alignment="TOP_CENTER" styleClass="page-container">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <VBox maxWidth="720" spacing="12" styleClass="page-inner">
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="My Library" styleClass="page-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Add Book" onAction="#toggleAddForm" styleClass="primary-button"/>
    </HBox>
    <VBox fx:id="addBookForm" spacing="8">
        <TextField fx:id="titleField" promptText="Title *"/>
        <TextField fx:id="authorField" promptText="Author *"/>
        <TextField fx:id="publisherField" promptText="Publisher"/>
        <TextField fx:id="addressField" promptText="Current Address (e.g. SSH, KUET)"/>
        <ComboBox fx:id="categoryComboBox" promptText="Category" maxWidth="Infinity"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button text="✨ Auto-fill from Open Library" onAction="#handleAutoFill">
                <tooltip><Tooltip text="Fetches publisher &amp; cover from openlibrary.org using title/author (runs in background)"/></tooltip>
            </Button>
            <ProgressIndicator fx:id="fetchSpinner" visible="false" mouseTransparent="true"
                               prefWidth="24" prefHeight="24" maxWidth="24" maxHeight="24"/>
            <Label fx:id="fetchLabel" styleClass="book-meta"/>
        </HBox>
        <Label fx:id="statusLabel" styleClass="error-label"/>
        <Button text="Save Book (+10 pts)" onAction="#handleAddBook" styleClass="primary-button"/>
        <Separator/>
    </VBox>
    <Label fx:id="emptyLabel" text="No books yet. Click + Add Book to add one!"/>
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox fx:id="booksContainer" spacing="10"/>
    </ScrollPane>
    </VBox>
</VBox>
