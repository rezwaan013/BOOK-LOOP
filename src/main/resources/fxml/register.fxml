<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.bookloop.controller.RegisterController"
           styleClass="root-stack">

    <VBox alignment="CENTER" maxWidth="440" styleClass="auth-card">

        <!-- Branding -->
        <VBox alignment="CENTER" spacing="6">
            <VBox.margin><Insets top="28" bottom="4"/></VBox.margin>
            <Label text="📚" style="-fx-font-size: 42px;"/>
            <Label text="Create Account" styleClass="app-title"/>
            <Label text="Join the BookLoop community" styleClass="app-subtitle"/>
        </VBox>

        <!-- Form Fields -->
        <VBox spacing="12">
            <VBox.margin><Insets top="24" right="36" bottom="8" left="36"/></VBox.margin>

            <VBox spacing="5">
                <Label text="Full Name *" styleClass="form-label"/>
                <TextField fx:id="fullNameField" promptText="Jane Smith" styleClass="input-field"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Phone Number *" styleClass="form-label"/>
                <TextField fx:id="phoneField" promptText="+1-555-0100" styleClass="input-field"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Email Address *" styleClass="form-label"/>
                <TextField fx:id="emailField" promptText="jane@example.com" styleClass="input-field"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Password (min 6 chars) *" styleClass="form-label"/>
                <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="input-field"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Confirm Password *" styleClass="form-label"/>
                <PasswordField fx:id="confirmPasswordField" promptText="••••••••" styleClass="input-field"/>
            </VBox>

            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" maxWidth="Infinity"/>
        </VBox>

        <!-- Actions -->
        <VBox spacing="10" alignment="CENTER">
            <VBox.margin><Insets top="4" right="36" bottom="8" left="36"/></VBox.margin>
            <Button text="Create Account" onAction="#handleRegister"
                    styleClass="primary-button" maxWidth="Infinity" minHeight="42"/>
        </VBox>

        <HBox alignment="CENTER" spacing="4">
            <VBox.margin><Insets bottom="28"/></VBox.margin>
            <Label text="Already have an account?" styleClass="auth-hint"/>
            <Hyperlink text="Sign In" onAction="#handleBackToLogin" styleClass="auth-link"/>
        </HBox>

    </VBox>
</StackPane>
