<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.bookloop.controller.RequestsController" spacing="12"
      alignment="TOP_CENTER" styleClass="page-container">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <VBox maxWidth="720" spacing="12" styleClass="page-inner">
    <Label text="Borrow Requests" styleClass="page-title"/>
    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
        <Tab text="Incoming (for my books)">
            <ScrollPane fitToWidth="true">
                <VBox spacing="10">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <Label fx:id="incomingEmptyLabel" text="No incoming requests."/>
                    <VBox fx:id="incomingContainer" spacing="10"/>
                </VBox>
            </ScrollPane>
        </Tab>
        <Tab text="My outgoing requests">
            <ScrollPane fitToWidth="true">
                <VBox spacing="10">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <Label fx:id="outgoingEmptyLabel" text="You have not requested any books yet."/>
                    <VBox fx:id="outgoingContainer" spacing="10"/>
                </VBox>
            </ScrollPane>
        </Tab>
    </TabPane>
    </VBox>
</VBox>
